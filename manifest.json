{
  "manifest_version": 3,
  "name": "RiceHub",
  "version": "1.0.0",
  "minimum_chrome_version": "95",
  "description": "Builds a structured analysis prompt from the GitHub repository you are viewing and hands it to your chosen AI agent.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "96": "src/icons/icon-96.png",
    "128": "src/icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/task.js",
        "src/destinations.js",
        "src/settings.js",
        "src/button.js",
        "src/mount.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/icons/fab/ricehub-fab-256.png"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
